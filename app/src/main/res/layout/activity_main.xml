<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── HEADER ─────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_location_alert"
                android:tint="@color/accent_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location Alert"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cảnh báo đến nơi"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Tracking indicator dot -->
            <View
                android:id="@+id/indicatorTracking"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/bg_dot_green"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── CURRENT LOCATION CARD ─────────────────────────── -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VỊ TRÍ HIỆN TẠI"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvCurrentLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Chưa có tín hiệu GPS"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Khoảng cách: --"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- ── TARGET LOCATION CARD ──────────────────────────── -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VỊ TRÍ ĐÍCH"
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Voice + Text input row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/etLocationInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="Nhập địa chỉ hoặc tên nơi..."
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:singleLine="true" />

                <!-- Voice button -->
                <ImageButton
                    android:id="@+id/btnVoiceInput"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_icon"
                    android:src="@drawable/ic_mic"
                    android:tint="@color/accent_blue"
                    android:contentDescription="Nhập bằng giọng nói" />

                <!-- Clear button -->
                <ImageButton
                    android:id="@+id/btnClearInput"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_icon"
                    android:src="@drawable/ic_clear"
                    android:tint="@color/alert_red"
                    android:contentDescription="Xóa và nhập lại" />
            </LinearLayout>

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btnSearchLocation"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="🔍 Tìm địa chỉ"
                    android:textSize="13sp"
                    android:backgroundTint="@color/accent_blue"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btnManualCoords"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="📌 Tọa độ"
                    android:textSize="13sp"
                    android:backgroundTint="@color/surface_card"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <!-- Coordinates display -->
            <TextView
                android:id="@+id/tvCoordinates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa có tọa độ"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <!-- Status -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa đặt vị trí đích"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ── ALERT SETTINGS CARD ────────────────────────────── -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CÀI ĐẶT CẢNH BÁO"
                android:textColor="@color/alert_orange"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Radius Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bán kính cảnh báo"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvRadiusValue"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="25m"
                    android:textColor="@color/accent_blue"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="end" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderRadius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:valueFrom="20"
                android:valueTo="300"
                android:value="50"
                android:stepSize="1"
                app:thumbColor="@color/accent_blue"
                app:trackColorActive="@color/accent_blue"
                app:trackColorInactive="@color/surface_elevated" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20m"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="300m"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp" />

            <!-- MP3 Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Âm thanh cảnh báo"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvMp3Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa chọn file (dùng âm thanh mặc định)"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSelectMp3"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="🎵 Chọn file MP3"
                    android:textSize="13sp"
                    android:backgroundTint="@color/surface_elevated"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnRemoveMp3"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="Xóa"
                    android:textSize="13sp"
                    android:backgroundTint="@color/alert_red"
                    android:textColor="@color/white"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── TRACKING CONTROL CARD ──────────────────────────── -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnStartTracking"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="10dp"
                android:text="▶  BẮT ĐẦU THEO DÕI"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/accent_green" />

            <Button
                android:id="@+id/btnStopTracking"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="⏹  DỪNG THEO DÕI"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/surface_elevated"
                android:enabled="false" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
