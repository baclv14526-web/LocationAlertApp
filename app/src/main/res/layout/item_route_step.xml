<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Cột trái: số thứ tự + đường thẳng nối -->
    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Icon mũi tên / bước -->
        <TextView
            android:id="@+id/tvStepIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="↑"
            android:textSize="18sp"
            android:gravity="center"
            android:textColor="@color/white"
            android:background="@drawable/bg_step_icon"/>

        <!-- Đường thẳng nối giữa các bước -->
        <View
            android:id="@+id/viewStepLine"
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            android:background="@color/divider"/>
    </LinearLayout>

    <!-- Cột phải: nội dung bước -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="4dp">

        <!-- Tên đường -->
        <TextView
            android:id="@+id/tvStepStreet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên đường"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"/>

        <!-- Hướng dẫn -->
        <TextView
            android:id="@+id/tvStepInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rẽ trái"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="2dp"/>

        <!-- Khoảng cách bước này -->
        <TextView
            android:id="@+id/tvStepDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="500m"
            android:textColor="@color/accent_blue"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_distance_chip"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"/>
    </LinearLayout>
</LinearLayout>
