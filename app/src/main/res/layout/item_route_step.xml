<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Cột trái: timeline dọc — chấm/icon + đường nối liên tục xuyên suốt
         chiều cao thực của item (dùng layout_weight thay vì chiều cao cố
         định) để trông liền mạch như timeline thật, không bị đứt quãng
         khi nội dung bước dài ngắn khác nhau. -->
    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="14dp">

        <!-- Đường nối phía trên — ẩn ở bước đầu tiên (điểm xuất phát) -->
        <View
            android:id="@+id/viewLineTop"
            android:layout_width="2.5dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/accent_blue"
            android:minHeight="6dp"/>

        <!-- Chấm/icon bước — to hơn ở đầu (xuất phát) và cuối (đến nơi)
             để nổi bật 2 đầu timeline, giống Google Maps -->
        <TextView
            android:id="@+id/tvStepIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="↑"
            android:textSize="15sp"
            android:gravity="center"
            android:textColor="@color/white"
            android:background="@drawable/bg_step_icon"
            android:elevation="2dp"/>

        <!-- Đường nối phía dưới — ẩn ở bước cuối cùng (điểm đến) -->
        <View
            android:id="@+id/viewLineBottom"
            android:layout_width="2.5dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/accent_blue"
            android:minHeight="6dp"/>
    </LinearLayout>

    <!-- Cột phải: nội dung bước -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Số thứ tự bước (nhỏ, phía trên tên đường) -->
        <TextView
            android:id="@+id/tvStepNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bước 1"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:layout_marginBottom="2dp"/>

        <!-- Tên đường -->
        <TextView
            android:id="@+id/tvStepStreet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên đường"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"/>

        <!-- Hướng dẫn -->
        <TextView
            android:id="@+id/tvStepInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rẽ trái"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="2dp"/>

        <!-- Khoảng cách bước này -->
        <TextView
            android:id="@+id/tvStepDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="500m"
            android:textColor="@color/accent_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_distance_chip"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"/>
    </LinearLayout>
</LinearLayout>
