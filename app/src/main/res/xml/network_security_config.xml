<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Base config: trust system CA cho TẤT CẢ domain (HTTPS).
        Android 9 cần khai báo tường minh, không dùng được implicit trust như Android 7-.
        Không cho phép cleartext (HTTP) — chỉ HTTPS.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
</network-security-config>
